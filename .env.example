# Variables del frontend público (repositorio independiente, desplegado en Vercel).
#
# En producción (Vercel → Project → Settings → Environment Variables):
#   VITE_API_URL=https://<tu-backend-publico>
# Sin esa variable el build compila, pero todas las llamadas a la API darán 404
# en el dominio de Vercel: el frontend no tiene backend propio.
#
# En desarrollo NO hace falta definirla: vite.config.js proxea /api y /static
# a http://localhost:8001 (el 8000 lo ocupa el backend interno del monorepo).
VITE_API_URL=

# Opcional, solo desarrollo: cambia el destino del proxy si tu backend
# del portal escucha en otro puerto.
# VITE_API_PROXY_TARGET=http://localhost:8001

# No pongas aquí claves de Supabase: el frontend nunca habla con Supabase,
# solo con el backend FastAPI.
